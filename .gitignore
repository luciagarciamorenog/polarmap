# Secrets
.env
*.env

# GDELT cache (20-40 MB por fichero, se regenera)
data/cache/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Detalle interno de cada corrida (axes.json sí va en git)
data/internal/*_full.json
# Corridas parciales: no son el mapa publicado
data/snapshot_partial.json
# Clasificación por titular de cada corrida (URLs; para auditar)
data/internal/*_headlines.jsonl
# Extractos de prensa (titular + entradilla): no se versionan
data/gold/leads_*.json
# Simulaciones del piloto (jueces falsos): no se versionan
data/pilot/MOCK_*/

# Capa social: textos de redes (respuestas y comentarios de particulares)
data/social/
.sync_tmp/
